{
  "name": "subagents-ai",
  "private": true,
  "version": "1.0.0",
  "description": "SubAgents AI — Multi-agent loop framework desktop app",
  "author": "SubAgents AI",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "open-design:index": "node scripts/open-design-inventory.mjs",
    "prototype:task-run-trust": "node --experimental-strip-types scripts/task-run-trust-prototype.mts",
    "build": "npm run open-design:index && tsc -b && vite build",
    "preview": "vite preview",
    "smoke": "npm run open-design:index && node scripts/smoke.mjs && node --experimental-strip-types scripts/smoke-platform.mts && node scripts/smoke-caps.mjs && node scripts/smoke-scenario-e2e.mjs && node --experimental-strip-types scripts/smoke-prod-modules.mts && npm run smoke:marketplace",
    "smoke:caps": "npm run open-design:index && node scripts/smoke-caps.mjs",
    "smoke:ci": "npm run open-design:index && node scripts/smoke.mjs && node --experimental-strip-types scripts/smoke-platform.mts && node scripts/smoke-caps.mjs && node scripts/smoke-scenario-e2e.mjs && node --experimental-strip-types scripts/smoke-prod-modules.mts",
    "smoke:scenario": "node scripts/smoke-scenario-e2e.mjs",
    "smoke:prod": "node --experimental-strip-types scripts/smoke-prod-modules.mts",
    "smoke:built": "node scripts/smoke.mjs --require-built",
    "smoke:marketplace": "vite build --config scripts/vite.plugin-e2e.config.ts && node .tmp/plugin-e2e/plugin-installer-e2e.mjs",
    "smoke:plugin-install": "vite build --config scripts/vite.plugin-e2e.config.ts && node .tmp/plugin-e2e/plugin-installer-e2e.mjs --network",
    "icons": "node scripts/render-icons.mjs && node scripts/make-ico.mjs",
    "dist": "npm run icons && npm run smoke && npm run build && npm run smoke:built && electron-builder",
    "dist:mac": "npm run icons && npm run smoke && npm run build && npm run smoke:built && electron-builder --mac",
    "dist:win": "npm run icons && npm run smoke && npm run build && npm run smoke:built && electron-builder --win",
    "dist:all": "npm run icons && npm run smoke && npm run build && npm run smoke:built && electron-builder --mac --win"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "simple-icons": "^11.15.0",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "ai.subagents.desktop",
    "productName": "SubAgents AI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "icon.ico",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icons",
        "to": "app-icons",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/brand",
        "to": "app-icons",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "app-icons/icon.ico"
      }
    ],
    "mac": {
      "icon": "icons/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    }
  }
}
